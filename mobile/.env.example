# ProjectTrack Mobile Client Configuration

# FastAPI Backend Gateway Address
# Use http://10.0.2.2:8000/api for Android Emulator, or http://<LAN_IP>:8000/api for physical devices
API_BASE_URL=http://10.0.2.2:8000/api

# Mandatory Geofencing Radius (meters)
GEOFENCE_RADIUS_METERS=100

# Offline Storage Limit
MAX_OFFLINE_QUEUE_ITEMS=500

# Testing Mode (Disables mandatory hardware GPS lock for emulator testing)
ENABLE_MOCK_GPS=false
