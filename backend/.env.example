# ==============================================================================
# DPWH Cebu Infrastructure Knowledge Graph & QA System - Environment Config
# ==============================================================================

# 1. Apify API Token (Optional: only needed if running the scraper)
# Get from: https://console.apify.com/account/integrations
APIFY_TOKEN="your_apify_api_token_here"

# 1b. Passive Periodic Scraping (APScheduler) — keeps the deployed graph fresh
# by re-scraping DPWH/PhilGEPS on a recurring interval and syncing into Neo4j,
# with no manual trigger. Durable last-run state is stored in Supabase
# (pipeline_schedule_state — see supabase/README.md). Safe to leave disabled in
# local dev; enable in production.
PASSIVE_SCRAPE_ENABLED="false"
PASSIVE_SCRAPE_INTERVAL_DAYS="90"
PASSIVE_SCRAPE_MAX_ITEMS="500"
PASSIVE_SCRAPE_SYNC_AFTER="true"
PASSIVE_SCRAPE_RUN_ON_STARTUP="false"
PASSIVE_SCRAPE_JOB_NAME="passive_scrape"

# 2. Supabase Storage (Required for scraper and data synchronization)
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"
# Storage bucket for citizen field-report photos (see supabase/README.md).
SUPABASE_REPORT_BUCKET="report-photos"

# 2b. Supabase Authentication (backend-managed login/session via GoTrue)
# anon key is from the same API settings page (safe to expose to the backend).
SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
# Optional: only needed if you want local JWT signature verification.
# SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"

# Web origin allowed to call the API with cookies, and the default redirect
# target for OAuth and e-mail-confirmation links. The `redirect` parameter on
# /api/auth/oauth and /api/auth/signup is validated against this plus
# CORS_ORIGINS (+ local dev origins), and the same URLs must be registered in
# the Supabase Auth redirect allow-list or Supabase silently redirects to Site URL.
FRONTEND_URL="http://localhost:5173"
# Optional explicit allow-list (JSON list or comma-separated). FRONTEND_URL is
# always allowed regardless. Only set this if you need extra origins.
# CORS_ORIGINS="https://projecttrack.pages.dev,https://www.example.com"

# Native mobile app URL schemes allowed as OAuth deep-link redirects (the
# mobile app can't use an http(s) redirect). Defaults to "projecttrack,exp".
# The same scheme must also be in the Supabase Auth redirect allow-list.
# MOBILE_APP_SCHEMES="projecttrack,exp"

# Session cookie behavior. In production over HTTPS set AUTH_COOKIE_SECURE=true.
# For cross-site cookies (different frontend domain) use AUTH_COOKIE_SAMESITE=none + SECURE=true.
AUTH_COOKIE_NAME="pt_session"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"

# --- Production (Cloudflare Pages -> Render) example ---------------------------
# The web app at https://projecttrack.pages.dev calling the API at
# https://projecttrack-28nb.onrender.com is CROSS-SITE, so the session cookie
# must be SameSite=None + Secure or browsers will drop it:
#   FRONTEND_URL="https://projecttrack.pages.dev"
#   AUTH_COOKIE_SECURE="true"
#   AUTH_COOKIE_SAMESITE="none"
#   CORS_ORIGINS="https://projecttrack.pages.dev"   # optional; FRONTEND_URL already allowed
# Also register https://projecttrack.pages.dev/* in the Supabase Auth
# redirect/origin allow-list (Dashboard -> Authentication -> URL Configuration).

# 3. Neo4j Graph Database (Required: AuraDB Free Cloud or Local Desktop)
# Create a free instance at: https://neo4j.com/cloud/platform/aura-graph-database/
# Example Cloud URI: neo4j+s://xxxxxxxx.databases.neo4j.io
# Example Local URI: bolt://localhost:7687
NEO4J_URI="neo4j+s://your-instance.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"

# 4. Groq LPU Configuration (Fast Inference, Free API Tier)
# Get your free API key at: https://console.groq.com/keys
# Supported models include:
#   - qwen/qwen3.8-27b         (Recommended: fast reasoning, ~500+ tok/s)
#   - llama-3.1-8b-instant     (Ultra-fast, lowest latency)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="qwen/qwen3.8-27b"
LLM_API_KEY="your_groq_api_key_here"
# GROQ_API_KEY="your_groq_api_key_here"  # Alternative key name supported
LLM_MAX_TOKENS=2048
