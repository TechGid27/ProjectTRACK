# ProjectTrack Mobile Client Configuration

# FastAPI Backend Gateway Address (read by the app at build time).
# The app auto-selects a sensible default per platform:
#   • Android emulator  -> http://10.0.2.2:8000/api
#   • Web               -> http://<current-host>:8000/api
#   • iOS simulator     -> http://localhost:8000/api
# To reach the backend cross-origin from a PHYSICAL device on your LAN, or a
# deployed backend, set EXPO_PUBLIC_API_URL explicitly (Expo only exposes env
# vars prefixed with EXPO_PUBLIC_ to the client bundle):
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api   (LAN device)
#   EXPO_PUBLIC_API_URL=https://api.projecttrack.ph/api (deployed)
# The backend already allows these origins via CORS (localhost/127/192.168.x/
# 10.x regex + FRONTEND_URL), so no backend change is needed for LAN testing.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Mandatory Geofencing Radius (meters). The backend re-validates this server-side
# against the project's authoritative DPWH coordinates (≤150m is the default).
GEOFENCE_RADIUS_METERS=150

# Offline Storage Limit
MAX_OFFLINE_QUEUE_ITEMS=500

# Testing Mode (Disables mandatory hardware GPS lock for emulator testing)
ENABLE_MOCK_GPS=false
