# ==============================================================================
# ProjectTRACK Mobile Client — Production & Environment Configuration
# ==============================================================================

# 1. FastAPI Backend API Gateway Address
# ------------------------------------------------------------------------------
# IN PRODUCTION (Standalone APK on physical devices):
#   Set to your public domain or backend IP, e.g.:
#   EXPO_PUBLIC_API_URL=https://api.projecttrack.org/api
#   or your Wi-Fi LAN IP (e.g. http://192.168.1.50:8000/api)
#
# IN LOCAL EMULATOR DEVELOPMENT:
#   Android emulator routes host localhost to 10.0.2.2:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
#
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
API_BASE_URL=http://10.0.2.2:8000/api

# 2. Mandatory Geofencing Radius (meters)
# ------------------------------------------------------------------------------
# The camera shutter stays locked until device GPS is within this radius
# of official DPWH coordinates. The backend also validates this server-side.
GEOFENCE_RADIUS_METERS=150

# 3. Offline Outbox Queue Limit
# ------------------------------------------------------------------------------
# Maximum number of offline field audits queued before forced background sync.
MAX_OFFLINE_QUEUE_ITEMS=500

# 4. Emulator Mock GPS Mode (DO NOT ENABLE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Set to 'false' for production APK builds. Set 'true' only when testing in
# emulators where hardware GPS fixes are simulated.
ENABLE_MOCK_GPS=false
