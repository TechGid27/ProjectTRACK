# ==============================================================================
# ProjectTRACK Unified Local Stack Environment (docker compose)
# Copy to .env and adjust values before running `docker compose up --build`
# ==============================================================================

# Neo4j local dev credentials (used by the neo4j and backend services)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=projecttrack

# Frontend build-time API base URL (must be reachable from your browser)
VITE_API_URL=http://localhost:8000

# Auth — the website authenticates only through the backend (never Supabase directly)
# Trusted frontend origin for OAuth redirects / cookie CORS inside docker compose
SITE_URL=http://localhost:8080
# Admin key guarding /api/pipeline/* (503 when unset)
ADMIN_API_KEY=
# Supabase project (backend-only; the browser never talks to Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=
