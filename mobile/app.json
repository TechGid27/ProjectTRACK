{
  "expo": {
    "name": "ProjectTRACK",
    "slug": "projecttrack-mobile",
    "scheme": "projecttrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/logo.png",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f3d3c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projecttrack.mobile"
    },
    "android": {
      "package": "com.projecttrack.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#1f3d3c"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "INTERNET"
      ],
      "usesCleartextTraffic": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "projecttrack",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ProjectTRACK uses your location to verify you are on-site (within 150m) before you can file a geofenced field report."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ProjectTRACK uses the camera for live on-site photo capture. Gallery uploads are disabled to preserve ground-truth integrity."
        }
      ],
      "expo-secure-store"
    ]
  }
}
